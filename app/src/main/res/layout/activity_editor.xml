<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oneui_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/oneui_bg">

        <LinearLayout
            android:id="@+id/segmented"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pill_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/segText"
                style="@style/Widget.OneUi.Segment"
                android:text="@string/mode_text" />

            <TextView
                android:id="@+id/segDraw"
                style="@style/Widget.OneUi.Segment"
                android:text="@string/mode_draw" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Chế độ văn bản -->
        <LinearLayout
            android:id="@+id/textPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.OneUi.Card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                app:cardCornerRadius="26dp">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="32dp">

                        <EditText
                            android:id="@+id/title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:fontFamily="sans-serif-medium"
                            android:hint="@string/hint_title"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences"
                            android:maxLines="2"
                            android:textColor="@color/oneui_text"
                            android:textColorHint="@color/oneui_text_secondary"
                            android:textSize="24sp" />

                        <TextView
                            android:id="@+id/date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/oneui_text_secondary"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="14dp"
                            android:background="@color/oneui_divider" />

                        <EditText
                            android:id="@+id/content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:gravity="top|start"
                            android:hint="@string/hint_content"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine|textCapSentences"
                            android:lineSpacingMultiplier="1.3"
                            android:minLines="10"
                            android:textColor="@color/oneui_text"
                            android:textColorHint="@color/oneui_text_secondary"
                            android:textSize="16sp" />
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <Button
                    android:id="@+id/actionDraw"
                    style="@style/Widget.OneUi.BottomAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mode_draw"
                    app:icon="@drawable/ic_pen" />

                <Button
                    android:id="@+id/actionShare"
                    style="@style/Widget.OneUi.BottomAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/share"
                    app:icon="@drawable/ic_share" />

                <Button
                    android:id="@+id/actionDelete"
                    style="@style/Widget.OneUi.BottomAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/delete"
                    app:icon="@drawable/ic_delete" />
            </LinearLayout>
        </LinearLayout>

        <!-- Chế độ vẽ tay -->
        <LinearLayout
            android:id="@+id/drawPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.OneUi.Card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/paper"
                app:cardCornerRadius="26dp"
                app:strokeColor="@color/oneui_divider"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <vn.io.nguyenquocanh.notepad.widget.DrawingView
                        android:id="@+id/drawing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/stylusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="14dp"
                        android:background="@drawable/bg_badge"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:text="@string/stylus_only_badge"
                        android:textColor="@color/badge_text"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tray"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/toolPen"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle"
                        android:contentDescription="@string/tool_pen"
                        android:src="@drawable/ic_pen" />

                    <ImageButton
                        android:id="@+id/toolEraser"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_circle"
                        android:contentDescription="@string/tool_eraser"
                        android:src="@drawable/ic_eraser" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/oneui_divider" />

                    <ImageButton
                        android:id="@+id/undo"
                        style="@style/Widget.OneUi.ToolButton"
                        android:contentDescription="@string/undo"
                        android:src="@drawable/ic_undo" />

                    <ImageButton
                        android:id="@+id/redo"
                        style="@style/Widget.OneUi.ToolButton"
                        android:contentDescription="@string/redo"
                        android:src="@drawable/ic_redo" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/clear"
                        style="@style/Widget.OneUi.ToolButton"
                        android:contentDescription="@string/clear"
                        android:src="@drawable/ic_clear_all" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/swatches"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="2dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pen_width"
                        android:textColor="@color/oneui_text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/widthSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="@string/pen_width"
                        android:stepSize="1"
                        android:value="4"
                        android:valueFrom="1"
                        android:valueTo="24" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
